import { Outlet, useNavigate, useLocation } from 'react-router-dom'
import { Layout, Menu, Button, Avatar, Dropdown, theme, Typography, Space, Badge, Tooltip } from 'antd'
import {
  DashboardOutlined,
  FolderOutlined,
  HddOutlined,
  LinkOutlined,
  SettingOutlined,
  MenuFoldOutlined,
  MenuUnfoldOutlined,
  UserOutlined,
  LogoutOutlined,
  CloudOutlined,
  GithubOutlined,
  SunOutlined,
  MoonOutlined,
  DatabaseOutlined,
} from '@ant-design/icons'
import { useQuery } from '@tanstack/react-query'
import { listSpaces } from '@/api/client'
import { useAuthStore, useUIStore } from '@/stores'

const { Header, Sider, Content } = Layout
const { Text } = Typography

function formatBytes(bytes: number) {
  if (!bytes || bytes === 0) return '0 B'
  const k = 1024
  const sizes = ['B', 'KB', 'MB', 'GB', 'TB']
  const i = Math.floor(Math.log(bytes) / Math.log(k))
  return parseFloat((bytes / Math.pow(k, i)).toFixed(1)) + ' ' + sizes[i]
}

export default function AppLayout() {
  const navigate = useNavigate()
  const location = useLocation()
  const { user, logout } = useAuthStore()
  const { sidebarCollapsed, toggleSidebar, darkMode, toggleDarkMode } = useUIStore()
  const { token: { colorBgContainer, colorBgLayout } } = theme.useToken()

  const { data: spacesRes } = useQuery({
    queryKey: ['spaces-summary'],
    queryFn: listSpaces,
    refetchInterval: 10000,
  })
  const spaces = (spacesRes?.data || []).filter(Boolean)

  const totalStorage = spaces.reduce((sum: number, s: any) => sum + (s.total_size || 0), 0)
  const usedStorage = spaces.reduce((sum: number, s: any) => sum + (s.used_size || 0), 0)
  const usagePercent = totalStorage > 0 ? Math.round((usedStorage / totalStorage) * 100) : 0

  const selectedKey = '/' + location.pathname.split('/')[1]

  const menuItems = [
    { key: '/dashboard', icon: <DashboardOutlined />, label: '仪表盘' },
    { key: '/files', icon: <FolderOutlined />, label: '文件管理' },
    { key: '/devices', icon: <HddOutlined />, label: '存储设备' },
    { key: '/shares', icon: <LinkOutlined />, label: '分享管理' },
    ...(user?.is_admin ? [{ key: '/admin', icon: <SettingOutlined />, label: '管理后台' }] : []),
  ]

  const userMenu = {
    items: [
      {
        key: 'profile',
        icon: <UserOutlined />,
        label: (
          <div>
            <div style={{ fontWeight: 600 }}>{user?.nickname || user?.username}</div>
            <div style={{ fontSize: 12, opacity: 0.6 }}>{user?.email || ''}</div>
          </div>
        ),
        disabled: true,
      },
      { type: 'divider' as const },
      { key: 'admin', icon: <SettingOutlined />, label: '系统设置', onClick: () => navigate('/admin') },
      { type: 'divider' as const },
      {
        key: 'logout',
        icon: <LogoutOutlined />,
        label: '退出登录',
        danger: true,
        onClick: () => { logout(); navigate('/login') },
      },
    ],
  }

  return (
    <Layout style={{ minHeight: '100vh', background: colorBgLayout, transition: 'all 0.3s' }}>
      <Sider
        trigger={null}
        collapsible
        collapsed={sidebarCollapsed}
        theme={darkMode ? 'dark' : 'light'}
        width={240}
        style={{
          borderRight: darkMode ? '1px solid #303030' : '1px solid #e8e8e8',
          boxShadow: sidebarCollapsed ? 'none' : '2px 0 8px rgba(0,0,0,0.05)',
          zIndex: 100,
          transition: 'all 0.2s',
        }}
      >
        <div style={{
          height: 64,
          display: 'flex',
          alignItems: 'center',
          justifyContent: 'center',
          borderBottom: darkMode ? '1px solid #303030' : '1px solid #f0f0f0',
          background: darkMode ? '#1f1f1f' : 'linear-gradient(135deg, #1677ff 0%, #0958d9 100%)',
          cursor: 'pointer',
        }} onClick={() => navigate('/dashboard')}>
          <Space>
            <CloudOutlined style={{ fontSize: 24, color: darkMode ? '#1677ff' : '#fff' }} />
            {!sidebarCollapsed && (
              <Text strong style={{ fontSize: 18, color: darkMode ? '#e8e8e8' : '#fff', letterSpacing: 1 }}>
                Memesplora
              </Text>
            )}
          </Space>
        </div>

        {!sidebarCollapsed && (
          <div style={{ padding: '16px 16px 8px', borderBottom: darkMode ? '1px solid #303030' : '1px solid #f0f0f0' }}>
            <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', marginBottom: 8 }}>
              <Text type="secondary" style={{ fontSize: 12, fontWeight: 500, textTransform: 'uppercase', letterSpacing: 0.5 }}>
                <DatabaseOutlined style={{ marginRight: 4 }} />存储空间
              </Text>
              <Text style={{ fontSize: 12, fontWeight: 600, color: darkMode ? '#1677ff' : '#1677ff' }}>
                {totalStorage > 0 ? `${usagePercent}%` : '--'}
              </Text>
            </div>
            <div style={{ height: 6, background: darkMode ? '#303030' : '#f0f0f0', borderRadius: 3, overflow: 'hidden' }}>
              <div style={{
                width: `${Math.max(usagePercent > 0 ? usagePercent : 2, 2)}%`,
                height: '100%',
                background: totalStorage > 0
                  ? usagePercent > 80 ? '#ff4d4f' : usagePercent > 60 ? '#faad14' : '#1677ff'
                  : darkMode ? '#303030' : '#e8e8e8',
                borderRadius: 3,
                transition: 'all 0.5s ease',
              }} />
            </div>
            <Text type="secondary" style={{ fontSize: 11, display: 'block', marginTop: 6, opacity: 0.7 }}>
              {totalStorage > 0
                ? `${formatBytes(usedStorage)} / ${formatBytes(totalStorage)}`
                : '暂无存储空间'}
            </Text>
          </div>
        )}

        <Menu
          mode="inline"
          selectedKeys={[selectedKey]}
          items={menuItems}
          onClick={({ key }) => navigate(key)}
          style={{ borderRight: 0, marginTop: 8 }}
        />
      </Sider>

      <Layout>
        <Header style={{
          padding: '0 24px',
          background: colorBgContainer,
          display: 'flex',
          alignItems: 'center',
          justifyContent: 'space-between',
          borderBottom: darkMode ? '1px solid #303030' : '1px solid #f0f0f0',
          height: 64,
          boxShadow: darkMode ? '0 1px 4px rgba(0,0,0,0.2)' : '0 1px 4px rgba(0,0,0,0.05)',
          transition: 'all 0.3s',
          position: 'sticky',
          top: 0,
          zIndex: 50,
        }}>
          <Space>
            <Tooltip title={sidebarCollapsed ? '展开侧边栏' : '收起侧边栏'}>
              <Button
                type="text"
                icon={sidebarCollapsed ? <MenuUnfoldOutlined /> : <MenuFoldOutlined />}
                onClick={toggleSidebar}
                style={{ fontSize: 16, width: 40, height: 40, cursor: 'pointer' }}
              />
            </Tooltip>
          </Space>

          <Space size={8}>
            <Tooltip title={darkMode ? '切换亮色模式' : '切换暗色模式'}>
              <Button
                type="text"
                icon={darkMode ? <SunOutlined /> : <MoonOutlined />}
                onClick={toggleDarkMode}
                style={{ fontSize: 16, width: 40, height: 40, cursor: 'pointer' }}
              />
            </Tooltip>
            <Tooltip title="文档">
              <Button
                type="text"
                icon={<GithubOutlined />}
                onClick={() => window.open('https://github.com/memesplora', '_blank')}
                style={{ fontSize: 16, width: 40, height: 40, cursor: 'pointer' }}
              />
            </Tooltip>
            <Dropdown menu={userMenu} placement="bottomRight" trigger={['click']}>
              <Space style={{
                cursor: 'pointer',
                padding: '4px 12px',
                borderRadius: 8,
                transition: 'all 0.2s',
                marginLeft: 8,
                border: darkMode ? '1px solid #303030' : '1px solid #f0f0f0',
              }}
                onMouseEnter={(e) => { (e.currentTarget as HTMLElement).style.background = darkMode ? '#303030' : '#f5f5f5' }}
                onMouseLeave={(e) => { (e.currentTarget as HTMLElement).style.background = 'transparent' }}
              >
                <Avatar icon={<UserOutlined />} style={{ backgroundColor: '#1677ff', width: 28, height: 28 }} />
                <Text strong style={{ color: darkMode ? '#e8e8e8' : '#333' }}>{user?.nickname || user?.username}</Text>
              </Space>
            </Dropdown>
          </Space>
        </Header>

        <Content style={{ margin: 24, transition: 'all 0.3s' }}>
          <div style={{
            padding: 24,
            minHeight: 360,
            background: colorBgContainer,
            borderRadius: 12,
            boxShadow: darkMode ? '0 1px 4px rgba(0,0,0,0.2)' : '0 1px 4px rgba(0,0,0,0.05)',
            transition: 'all 0.3s',
          }}>
            <Outlet />
          </div>
        </Content>
      </Layout>
    </Layout>
  )
}