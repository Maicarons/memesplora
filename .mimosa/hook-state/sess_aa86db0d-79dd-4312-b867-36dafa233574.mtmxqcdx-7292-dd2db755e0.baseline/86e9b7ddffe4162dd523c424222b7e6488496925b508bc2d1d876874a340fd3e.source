import { useState, useEffect } from 'react'
import { useParams, useNavigate } from 'react-router-dom'
import { useQuery, useMutation, useQueryClient } from '@tanstack/react-query'
import {
  Table, Breadcrumb, Button, Space, Modal, Input, Upload, message, Spin, Tag, Select,
  Tooltip, Typography, Card, Row, Col, Empty,
} from 'antd'
import {
  FolderOutlined, FileOutlined, UploadOutlined, DownloadOutlined,
  DeleteOutlined, ShareAltOutlined, EditOutlined, CopyOutlined,
  ScissorOutlined, PlusOutlined, EyeOutlined, ReloadOutlined,
  HomeOutlined, CloudOutlined, FolderOpenOutlined,
} from '@ant-design/icons'
import { listFiles, uploadFile, deleteFile, createDir, listSpaces, downloadFile, createShare } from '@/api/client'
import { useFileStore } from '@/stores'

const { Text } = Typography

export default function FilesPage() {
  const { spaceId } = useParams()
  const navigate = useNavigate()
  const queryClient = useQueryClient()
  const { currentSpace, currentPath, setCurrentSpace, setCurrentPath } = useFileStore()
  const [selectedRowKeys, setSelectedRowKeys] = useState<string[]>([])
  const [dirModalOpen, setDirModalOpen] = useState(false)
  const [newDirName, setNewDirName] = useState('')
  const [uploadModalOpen, setUploadModalOpen] = useState(false)
  const [shareModalOpen, setShareModalOpen] = useState(false)
  const [shareFileId, setShareFileId] = useState('')
  const [sharePassword, setSharePassword] = useState('')
  const [previewModalOpen, setPreviewModalOpen] = useState(false)
  const [previewContent, setPreviewContent] = useState('')
  const [previewTitle, setPreviewTitle] = useState('')
  const [previewType, setPreviewType] = useState<'text' | 'image' | 'video' | 'audio' | 'pdf' | 'unsupported'>('text')
  const [previewUrl, setPreviewUrl] = useState('')

  // Detect file type from extension
  const getFileType = (fileName: string): 'text' | 'image' | 'video' | 'audio' | 'pdf' | 'unsupported' => {
    const ext = fileName.split('.').pop()?.toLowerCase() || ''
    const textExts = ['txt', 'md', 'json', 'xml', 'yaml', 'yml', 'toml', 'ini', 'cfg', 'conf', 'log', 'csv', 'tsv', 'css', 'js', 'ts', 'jsx', 'tsx', 'html', 'htm', 'php', 'py', 'rb', 'go', 'rs', 'java', 'c', 'cpp', 'h', 'hpp', 'sh', 'bash', 'bat', 'ps1', 'sql', 'r', 'lua', 'pl', 'swift', 'kt', 'gradle', 'properties', 'env', 'gitignore', 'dockerfile', 'makefile']
    const imageExts = ['jpg', 'jpeg', 'png', 'gif', 'webp', 'bmp', 'svg', 'ico', 'tiff', 'tif', 'avif']
    const videoExts = ['mp4', 'webm', 'ogg', 'mov', 'avi', 'mkv', 'wmv', 'flv', 'm4v']
    const audioExts = ['mp3', 'wav', 'ogg', 'flac', 'aac', 'wma', 'm4a', 'opus']
    if (textExts.includes(ext)) return 'text'
    if (imageExts.includes(ext)) return 'image'
    if (videoExts.includes(ext)) return 'video'
    if (audioExts.includes(ext)) return 'audio'
    if (ext === 'pdf') return 'pdf'
    return 'unsupported'
  }

  const { data: spacesRes } = useQuery({ queryKey: ['spaces'], queryFn: listSpaces })
  const spaces = (spacesRes?.data || []).filter(Boolean)
  const effectiveSpaceId = spaceId || currentSpace || spaces[0]?.id

  useEffect(() => {
    if (spaceId) {
      setCurrentSpace(spaceId)
      setCurrentPath('/')
    }
  }, [spaceId])

  useEffect(() => {
    if (spaces.length > 0 && !effectiveSpaceId) {
      setCurrentSpace(spaces[0].id)
    }
  }, [spaces])

  const { data: filesRes, isLoading, refetch } = useQuery({
    queryKey: ['files', effectiveSpaceId, currentPath],
    queryFn: () => listFiles(effectiveSpaceId, currentPath),
    enabled: !!effectiveSpaceId,
  })

  const files = filesRes?.data?.files || []

  const deleteMutation = useMutation({
    mutationFn: (fileIds: string[]) => Promise.all(fileIds.map((id) => deleteFile(effectiveSpaceId, id))),
    onSuccess: () => {
      message.success('删除成功')
      setSelectedRowKeys([])
      queryClient.invalidateQueries({ queryKey: ['files', effectiveSpaceId] })
    },
    onError: (err: any) => {
      message.error(`删除失败: ${err?.response?.data?.message || err.message || '未知错误'}`)
    },
  })

  const createDirMutation = useMutation({
    mutationFn: () => createDir(effectiveSpaceId, currentPath + '/' + newDirName),
    onSuccess: () => {
      message.success('目录创建成功')
      setDirModalOpen(false)
      setNewDirName('')
      queryClient.invalidateQueries({ queryKey: ['files', effectiveSpaceId] })
    },
    onError: (err: any) => {
      message.error(`创建失败: ${err?.response?.data?.message || err.message || '未知错误'}`)
    },
  })

  const shareMutation = useMutation({
    mutationFn: () => createShare({ file_id: shareFileId, space_id: effectiveSpaceId, password: sharePassword || undefined, is_password: !!sharePassword }),
    onSuccess: (data: any) => {
      const shareKey = data?.data?.share_key
      if (shareKey) {
        const url = `${window.location.origin}/share/${shareKey}`
        navigator.clipboard.writeText(url)
        message.success(`分享链接已复制: ${url}`)
      } else {
        message.success('分享链接已创建')
      }
      setShareModalOpen(false)
      setSharePassword('')
    },
    onError: (err: any) => {
      message.error(`分享失败: ${err?.response?.data?.message || err.message || '未知错误'}`)
    },
  })

  const handleDownload = async (fileId: string, fileName: string) => {
    try {
      const blob = await downloadFile(effectiveSpaceId, fileId)
      const url = URL.createObjectURL(blob)
      const a = document.createElement('a')
      a.href = url
      a.download = fileName
      a.click()
      URL.revokeObjectURL(url)
    } catch (err: any) {
      message.error(`下载失败: ${err?.response?.data?.message || err.message || '未知错误'}`)
    }
  }

  const handlePreview = async (fileId: string, fileName: string) => {
    const ftype = getFileType(fileName)
    setPreviewTitle(fileName)
    setPreviewType(ftype)

    try {
      const blob = await downloadFile(effectiveSpaceId, fileId)
      const url = URL.createObjectURL(blob)
      setPreviewUrl(url)

      if (ftype === 'text') {
        const text = await blob.text()
        setPreviewContent(text.slice(0, 50000))
      } else {
        setPreviewContent('')
      }
      setPreviewModalOpen(true)
    } catch (err: any) {
      message.error(`预览失败: ${err?.response?.data?.message || err.message || '未知错误'}`)
    }
  }

  // Cleanup blob URLs when modal closes
  const handlePreviewClose = () => {
    if (previewUrl) {
      URL.revokeObjectURL(previewUrl)
      setPreviewUrl('')
    }
    setPreviewModalOpen(false)
    setPreviewContent('')
  }

  const formatBytes = (bytes: number) => {
    if (!bytes) return '-'
    const k = 1024
    const sizes = ['B', 'KB', 'MB', 'GB', 'TB']
    const i = Math.floor(Math.log(bytes) / Math.log(k))
    return parseFloat((bytes / Math.pow(k, i)).toFixed(2)) + ' ' + sizes[i]
  }

  const columns = [
    {
      title: '文件名',
      dataIndex: 'name',
      key: 'name',
      render: (name: string, record: any) => (
        <span
          style={{ cursor: record.type === 'directory' ? 'pointer' : 'default', color: '#1677ff' }}
          onClick={() => {
            if (record.type === 'directory') {
              setCurrentPath(currentPath === '/' ? '/' + name : currentPath + '/' + name)
            }
          }}
        >
          {record.type === 'directory' ? <FolderOutlined style={{ marginRight: 8, color: '#faad14' }} /> : <FileOutlined style={{ marginRight: 8, color: '#1677ff' }} />}
          {name}
        </span>
      ),
    },
    { title: '大小', dataIndex: 'size', key: 'size', render: (v: number) => formatBytes(v), width: 120 },
    {
      title: '类型', dataIndex: 'type', key: 'type', width: 80,
      render: (v: string) => <Tag color={v === 'file' ? 'blue' : 'orange'}>{v === 'file' ? '文件' : '目录'}</Tag>,
    },
    {
      title: '修改时间', dataIndex: 'modified_at', key: 'modified_at', width: 180,
      render: (v: string) => v?.slice(0, 19).replace('T', ' '),
    },
    {
      title: '操作', key: 'actions', width: 280,
      render: (_: any, record: any) => (
        <Space size="small">
          {record.type === 'file' && (
            <>
              <Tooltip title="预览"><Button type="link" size="small" icon={<EyeOutlined />} onClick={() => handlePreview(record.id, record.name)} /></Tooltip>
              <Tooltip title="下载"><Button type="link" size="small" icon={<DownloadOutlined />} onClick={() => handleDownload(record.id, record.name)} /></Tooltip>
              <Tooltip title="分享"><Button type="link" size="small" icon={<ShareAltOutlined />} onClick={() => { setShareFileId(record.id); setShareModalOpen(true) }} /></Tooltip>
            </>
          )}
          {record.type === 'directory' && (
            <Tooltip title="分享"><Button type="link" size="small" icon={<ShareAltOutlined />} onClick={() => { setShareFileId(record.id); setShareModalOpen(true) }} /></Tooltip>
          )}
          <Tooltip title="删除"><Button type="link" size="small" icon={<DeleteOutlined />} danger onClick={() => deleteMutation.mutate([record.id])} /></Tooltip>
        </Space>
      ),
    },
  ]

  const breadcrumbItems = [
    {
      title: <a onClick={() => setCurrentPath('/')}><HomeOutlined /> 我的文件</a>,
      key: 'home',
    },
    ...currentPath.split('/').filter(Boolean).map((part, i, arr) => ({
      title: i < arr.length - 1
        ? <a onClick={() => setCurrentPath('/' + arr.slice(0, i + 1).join('/'))}>{part}</a>
        : part,
      key: i,
    })),
  ]

  return (
    <div style={{ padding: 0 }}>
      {/* Top Bar */}
      <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', marginBottom: 16, flexWrap: 'wrap', gap: 8 }}>
        <Space>
          <Select
            value={effectiveSpaceId}
            onChange={(val) => { setCurrentSpace(val); setCurrentPath('/'); setSelectedRowKeys([]) }}
            style={{ width: 200 }}
            options={spaces.map((s: any) => ({ label: `📁 ${s.name}`, value: s.id }))}
            placeholder="选择存储空间"
          />
          <Breadcrumb items={breadcrumbItems} />
        </Space>
        <Space>
          {selectedRowKeys.length > 0 && (
            <>
              <Text type="secondary">已选 {selectedRowKeys.length} 项</Text>
              <Button danger icon={<DeleteOutlined />} onClick={() => deleteMutation.mutate(selectedRowKeys)}>批量删除</Button>
            </>
          )}
          <Button icon={<PlusOutlined />} onClick={() => setDirModalOpen(true)}>新建文件夹</Button>
          <Button type="primary" icon={<UploadOutlined />} onClick={() => setUploadModalOpen(true)}>上传文件</Button>
          <Button icon={<ReloadOutlined />} onClick={() => refetch()} />
        </Space>
      </div>

      {/* Empty state when no space selected */}
      {!effectiveSpaceId && spaces.length === 0 && (
        <Card style={{ textAlign: 'center', padding: 60 }}>
          <Empty description={
            <span>
              <p>暂无存储空间</p>
              <Button type="primary" onClick={() => navigate('/devices')}>前往创建空间</Button>
            </span>
          } />
        </Card>
      )}

      {/* File Table */}
      {effectiveSpaceId && (
        <Spin spinning={isLoading}>
          <Card style={{ padding: 0 }} bodyStyle={{ padding: 0 }}>
            <Table
              rowKey="id"
              dataSource={files}
              columns={columns}
              pagination={false}
              size="middle"
              rowSelection={{
                selectedRowKeys,
                onChange: (keys) => setSelectedRowKeys(keys as string[]),
              }}
              locale={{ emptyText: <Empty description="此目录为空，点击上方「上传文件」添加" /> }}
              onRow={(record) => ({
                onDoubleClick: () => {
                  if (record.type === 'directory') {
                    setCurrentPath(currentPath === '/' ? '/' + record.name : currentPath + '/' + record.name)
                  }
                },
              })}
            />
          </Card>
        </Spin>
      )}

      {/* New Folder Modal */}
      <Modal
        title="新建文件夹"
        open={dirModalOpen}
        onOk={() => createDirMutation.mutate()}
        onCancel={() => setDirModalOpen(false)}
        confirmLoading={createDirMutation.isPending}
        okText="创建"
        cancelText="取消"
      >
        <Input
          placeholder="输入文件夹名称"
          value={newDirName}
          onChange={(e) => setNewDirName(e.target.value)}
          onPressEnter={() => createDirMutation.mutate()}
          autoFocus
        />
      </Modal>

      {/* Upload Modal */}
      <Modal
        title="上传文件"
        open={uploadModalOpen}
        onCancel={() => setUploadModalOpen(false)}
        footer={null}
        destroyOnClose
      >
        <Upload.Dragger
          multiple
          showUploadList
          customRequest={async ({ file, onSuccess, onError }) => {
            try {
              await uploadFile(effectiveSpaceId, currentPath, file as File)
              message.success(`✅ ${(file as File).name} 上传成功`)
              onSuccess?.(null)
              queryClient.invalidateQueries({ queryKey: ['files', effectiveSpaceId] })
            } catch (err: any) {
              const errMsg = err?.response?.data?.message || err.message || '未知错误'
              message.error(`❌ ${(file as File).name} 上传失败: ${errMsg}`)
              onError?.(err as Error)
            }
          }}
        >
          <p className="ant-upload-drag-icon"><UploadOutlined /></p>
          <p>点击或拖拽文件到此处上传</p>
          <p style={{ color: '#999', fontSize: 12 }}>支持单个或多个文件上传</p>
        </Upload.Dragger>
      </Modal>

      {/* Share Modal */}
      <Modal
        title="创建分享链接"
        open={shareModalOpen}
        onOk={() => shareMutation.mutate()}
        onCancel={() => { setShareModalOpen(false); setSharePassword('') }}
        confirmLoading={shareMutation.isPending}
        okText="创建分享"
        cancelText="取消"
      >
        <p>创建分享链接，其他人可以通过链接下载此文件。</p>
        <Input
          placeholder="设置分享密码（可选）"
          value={sharePassword}
          onChange={(e) => setSharePassword(e.target.value)}
          style={{ marginTop: 8 }}
        />
      </Modal>

      {/* Preview Modal */}
      <Modal
        title={previewTitle}
        open={previewModalOpen}
        onCancel={handlePreviewClose}
        footer={null}
        width={previewType === 'text' ? 700 : 900}
        destroyOnClose
      >
        {previewType === 'text' && (
          <pre style={{ maxHeight: 500, overflow: 'auto', background: '#f5f5f5', padding: 16, borderRadius: 8, whiteSpace: 'pre-wrap', wordBreak: 'break-all', fontSize: 13, lineHeight: 1.6 }}>
            {previewContent || '(空文件)'}
          </pre>
        )}
        {previewType === 'image' && previewUrl && (
          <div style={{ textAlign: 'center' }}>
            <img src={previewUrl} alt={previewTitle} style={{ maxWidth: '100%', maxHeight: '70vh', borderRadius: 8 }} />
          </div>
        )}
        {previewType === 'video' && previewUrl && (
          <div style={{ textAlign: 'center' }}>
            <video controls style={{ maxWidth: '100%', maxHeight: '70vh', borderRadius: 8 }} autoPlay>
              <source src={previewUrl} />
              您的浏览器不支持视频播放
            </video>
          </div>
        )}
        {previewType === 'audio' && previewUrl && (
          <div style={{ textAlign: 'center', padding: 40 }}>
            <audio controls style={{ width: '100%' }} autoPlay>
              <source src={previewUrl} />
              您的浏览器不支持音频播放
            </audio>
          </div>
        )}
        {previewType === 'pdf' && previewUrl && (
          <iframe src={previewUrl} style={{ width: '100%', height: '70vh', border: 'none', borderRadius: 8 }} />
        )}
        {previewType === 'unsupported' && (
          <div style={{ textAlign: 'center', padding: 40, color: '#999' }}>
            <FileOutlined style={{ fontSize: 48, marginBottom: 16 }} />
            <p>暂不支持预览此文件格式，请下载后查看</p>
          </div>
        )}
      </Modal>
    </div>
  )
}