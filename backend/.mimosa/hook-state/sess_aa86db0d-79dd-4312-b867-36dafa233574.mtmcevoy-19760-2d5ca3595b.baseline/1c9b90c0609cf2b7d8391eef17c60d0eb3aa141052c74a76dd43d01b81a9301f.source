//go:build linux || windows

package device

import (
	"context"
	"fmt"
	"os"
	"strconv"
	"strings"
)

type RAMDetector struct{}

func NewRAMDetector() *RAMDetector {
	return &RAMDetector{}
}

func (d *RAMDetector) Detect() ([]Device, error) {
	totalMem, err := getTotalMemory()
	if err != nil {
		return nil, err
	}

	// Use half of available memory as default max allocation
	usableSize := totalMem / 2

	dev, err := NewRAMDevice("ram_0", usableSize)
	if err != nil {
		return nil, fmt.Errorf("failed to create RAM device: %w", err)
	}

	return []Device{dev}, nil
}

func getTotalMemory() (uint64, error) {
	// Try /proc/meminfo first (Linux)
	data, err := os.ReadFile("/proc/meminfo")
	if err == nil {
		for _, line := range strings.Split(string(data), "\n") {
			if strings.HasPrefix(line, "MemTotal:") {
				fields := strings.Fields(line)
				if len(fields) >= 2 {
					kb, err := strconv.ParseUint(fields[1], 10, 64)
					if err == nil {
						return kb * 1024, nil
					}
				}
			}
		}
	}

	// Fallback: use environment variable for testing
	if val := os.Getenv("MEMESPLORA_MEMORY_SIZE"); val != "" {
		size, err := strconv.ParseUint(val, 10, 64)
		if err == nil {
			return size, nil
		}
	}

	// Default: 1GB
	return 1 * 1024 * 1024 * 1024, nil
}

type GPUDetector struct{}

func NewGPUDetector() *GPUDetector {
	return &GPUDetector{}
}

func (d *GPUDetector) Detect() ([]Device, error) {
	// Stub: In production, use NVML to detect NVIDIA GPUs
	// nvml.Init() -> nvml.DeviceGetCount() -> nvml.DeviceGetHandleByIndex()
	// -> device.GetName() -> device.GetMemoryInfo()
	if os.Getenv("MEMESPLORA_ENABLE_GPU") == "" {
		return nil, nil
	}

	// Example: return a simulated GPU device
	return []Device{
		NewVRAMDevice("gpu_0", 0, 24*1024*1024*1024, "NVIDIA GPU (simulated)"),
	}, nil
}